{
  "name": "lll",
  "version": "0.2.0",
  "private": true,
  "description": "LifeLongLearn — local learning workbench (Go backend + static frontend).",
  "scripts": {
    "build": "npm --prefix frontend run build && go build -o dist/lll.exe ./backend-go/cmd/lll",
    "build:backend": "go build -o dist/lll.exe ./backend-go/cmd/lll",
    "desktop:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Install-Desktop-Shortcut.ps1",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Stop-LLL.ps1",
    "run": "go run ./backend-go/cmd/lll",
    "start": "dist/lll.exe",
    "test": "go test ./...",
    "test:verbose": "go test -v ./...",
    "archcheck": "go run ./tools/archcheck -repo . -report .artifacts/quality/architecture/dependency-report.json",
    "check:fast": "node tools/check/run-check.js fast",
    "check": "node tools/check/run-check.js complete",
    "check:full": "node tools/check/run-check.js full"
  },
  "engines": {
    "go": ">=1.22"
  }
}
